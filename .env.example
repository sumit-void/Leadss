# ============================================================
# LeadGen Pro — Environment Configuration
# Copy this file to .env and fill in your values
# ALL services are FREE — no paid APIs required
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen_secret_2024
POSTGRES_DB=leadgen

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- AI Audit (Optional — 100% free with Ollama) ---
# Leave empty to use rule-based scoring only (default, no API needed)
# For free local AI: install Ollama (https://ollama.ai), run `ollama pull llama3`
# Then set: OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3

# --- Scraping Settings ---
MAX_SEARCH_RESULTS=50
MAX_SEARCH_PAGES=3
CRAWL_CONCURRENCY=5
REQUEST_DELAY_MIN=3
REQUEST_DELAY_MAX=7

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
